{
  "name": "vscode-browser-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "VS Code Browser Bridge: a local named-pipe bridge for trusted local applications to access Copilot models.",
  "main": "src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-browser-bridge.start",
        "title": "VS Code Bridge: Enable"
      },
      {
        "command": "vscode-browser-bridge.stop",
        "title": "VS Code Bridge: Stop"
      },
      {
        "command": "vscode-browser-bridge.copyToken",
        "title": "VS Code Bridge: Copy Access Token"
      },
      {
        "command": "vscode-browser-bridge.disable",
        "title": "VS Code Bridge: Disable and Revoke Token"
      }
    ]
  },
  "scripts": {
    "json": "node --test",
    "test": "node --test --experimental-test-coverage",
    "scan:forbidden": "node scripts/forbidden-api-scan.js && node scripts/secret-scan.js",
    "scan:secrets": "node scripts/secret-scan.js",
    "scan": "node scripts/forbidden-api-scan.js && node scripts/secret-scan.js",
    "package": "node scripts/package-vsix.js",
    "package:vsix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-vsix.ps1",
    "hooks:install": "git config core.hooksPath .githooks",
    "verify": "node scripts/forbidden-api-scan.js && node scripts/secret-scan.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeeharArora/AI_LeverageVSCodeModelsToOtherProjects"
  },
  "dependencies": {},
  "devDependencies": {}
}
